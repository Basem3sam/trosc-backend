# Copy this file to .env and fill in real values before running the server.
# See README.md > Environment Variables for the full reference table.

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Full MongoDB connection string. If you embed <PASSWORD>/<USERNAME>
# placeholders here, also set DATABASE_PASSWORD / DATABASE_USERNAME below.
DATABASE_URL=mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/trosc
# DATABASE_URL=mongodb://localhost:27017/trosc   # local alternative
DATABASE_USERNAME=
DATABASE_PASSWORD=
MONGODB_POOL_SIZE=10

# --- Auth / JWT ---
# Must be at least 32 characters — the server refuses to start otherwise.
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=7

# --- CORS / URLs ---
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5000

# --- Rate Limiting ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Email (required for password reset / welcome emails) ---
# Development: point these at a Mailtrap inbox.
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Trosc Club <noreply@trosc.club>
# Production: set EMAIL_SERVICE instead of EMAIL_HOST/EMAIL_PORT (e.g. SendGrid).
EMAIL_SERVICE=SendGrid

# --- Misc ---
# Inbox notified whenever someone submits the public contact form.
ADMIN_EMAIL=