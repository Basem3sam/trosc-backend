# 🌐 SERVER CONFIG
NODE_ENV=development
PORT=10000
NODE_VERSION=20
BASE_URL=https://your-app.onrender.com
FRONTEND_URL=https://your-frontend.example.com
EXTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 🧩 DATABASE
# Get these from your MongoDB Atlas cluster (Database Access / Connect)
DATABASE_USERNAME=myapp_db_user
DATABASE_PASSWORD=changeme_db_password
DATABASE_URL=mongodb+srv://<USERNAME>:<PASSWORD>@myapp-cluster.mongodb.net/myapp_db?appName=MyApp

# 🔐 AUTHENTICATION
# Generate a long random string, e.g.: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_random_base64_string_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# 📧 EMAIL (NODEMAILER)
# Dev: use a sandbox provider like Mailtrap
EMAIL_USER=1a2b3c4d5e6f7g
EMAIL_PASS=h8i9j0k1l2m3n4
EMAIL_FROM="My App <no-reply@myapp.com>"
EMAIL_PORT=587
EMAIL_HOST=sandbox.smtp.mailtrap.io

# then in your PRODUCTION env (not this file):
# EMAIL_SERVICE=Gmail
# EMAIL_USER=noreply@myapp.com
# EMAIL_PASS=your_production_app_password

# Test recipient (used by scripts like testEmail.js)
TEST_EMAIL=dev@myapp.com

# 🧰 SECURITY
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# 🪪 ADMIN DEFAULT ACCOUNT (optional)
ADMIN_EMAIL=admin@myapp.com
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# 📬 MESSAGES (for logging or environment indicators)
APP_NAME=My App Backend
APP_OWNER=Your Name

MONGODB_POOL_SIZE=10
