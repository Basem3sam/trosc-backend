NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/trosc

# Auth
JWT_SECRET=supersecretkey_min_32_chars
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=7

# Frontend (required — used for CORS and password reset email links)
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5000

# Rate limiting (optional, has defaults)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# Email
EMAIL_SERVICE=Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Trosc Club <noreply@trosc.club>

_(Don’t forget to replace credentials.)_